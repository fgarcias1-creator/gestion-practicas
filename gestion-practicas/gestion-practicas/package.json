{
  "name": "gestion-practicas",
  "version": "2.0.0",
  "description": "Backend SOA/REST de la plataforma de Gestión de Prácticas Académicas (Node.js + PostgreSQL + MongoDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
