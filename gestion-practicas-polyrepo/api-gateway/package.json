{
  "name": "api-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Punto único de entrada. Valida el JWT y enruta cada /api/v1/<recurso> al servicio dueño del dominio. No tiene base de datos.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  }
}
